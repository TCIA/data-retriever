  "@type": "sc:Dataset",
  "@id": "https://doi.org/10.7937/E4WT-CD02",
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "name": "Breast Cancer Screening - Digital Breast Tomosynthesis",
  "alternateName": "Breast-Cancer-Screening-DBT",
  "license": [
    "https://creativecommons.org/licenses/by-nc/4.0/"
  ],
  "citeAs": "Buda, M., Saha, A., Walsh, R., Ghate, S., Li, N., Swiecicki, A., Lo, J. Y., Yang, J., & Mazurowski, M. (2020). Breast Cancer Screening - Digital Breast Tomosynthesis (BCS-DBT) (Version 5) [dataset]. The Cancer Imaging Archive. https://doi.org/10.7937/E4WT-CD02",
  "conditionsOfAccess": "Open-access TCIA data with a noncommercial-use license condition. Users must follow the listed license and TCIA Data Usage Policies and Restrictions.",
  "description": "Bounded Data Retriever smoke-test derivative. Only the checked-in sample records are included; full imaging cohorts, archives, optional source downloads and Aspera packages are excluded. This does not represent the complete dataset.",
  "prov:wasDerivedFrom": {
    "@type": "sc:CreativeWork",
    "name": "Original TCIA Croissant regression fixture",
    "url": "https://github.com/TCIA/data-retriever/blob/8d0d394ef63d94ead01bcdae835c7b61ceb6c196/benchmarkManifests/examples/croissant/breast-cancer-screening-dbt.noncommercial.croissant.jsonld"
  },
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "@id": "smoke-dbt.csv",
      "name": "dbt.csv bounded payload inventory",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "dbt.csv/SeriesInstanceUID",
          "name": "SeriesInstanceUID",
          "dataType": "sc:Text",
